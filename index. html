
<!DOCTYPE html>
<html>
<head>
    <title>Student Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <h1>Student Management System</h1>
    <h2>Student Details</h2>

    <form id="studentForm">
        <input type="text" id="name" placeholder="Enter Name" required><br><br>

        <input type="number" id="roll" placeholder="Enter Roll Number" required><br><br>

        <input type="text" id="course" placeholder="Enter Course" required><br><br>

        <button type="submit">Add Student</button>
    </form>

    <table border="1">
        <thead>
            <tr>
                <th>Name</th>
                <th>Roll No</th>
                <th>Course</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="studentList">
            <tr>
                <td>Himani</td>
                <td>136</td>
                <td>B.Tech</td>
                <td><button type="button" onclick="this.closest('tr').remove()">Delete</button></td>
            </tr>
        </tbody>
    </table>

    <script src="script.js"></script>
</body>
</html>

